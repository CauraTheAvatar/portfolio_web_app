---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import ScrollProgress from "../components/ScrollProgress.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "C'aura Technology",
  description = "With a passion for clean code and thoughtful design, we bridge the gap between software engineering precision and creative vision — turning ideas into polished digital experiences. We provide top quality technical solutions for your corporate needs.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf8f1" />
    <link rel="icon" type="image/png" href="/images/caura-logo-gold.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alice&family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Gate JS-dependent styles behind a .js class so no-JS fallback is fully visible
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <ScrollProgress />
    <Navbar />
    <main>
      <slot />
    </main>
  </body>
</html>
