---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScriptureRotator from "../components/ScriptureRotator.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "C'AURA TECHNOLOGY | Full-Stack Flutter Developer",
  description = "Software development, data analytics, and design — building elegant solutions one line of code at a time.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cauratechnology.netlify.app" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-ink antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <ScriptureRotator />
    <Footer />
  </body>
</html>
